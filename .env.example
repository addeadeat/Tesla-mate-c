# Copy to deploy/.env for Compose; never commit the filled copy.
# Generate locally; ENCRYPTION_KEY is not a Tesla token. Keep it with secure backups.
ENCRYPTION_KEY=
DATABASE_USER=teslamate
DATABASE_PASS=
DATABASE_NAME=teslamate
TZ=Asia/Hong_Kong
# NAS LAN use: replace with the NAS's exact private IP, never 0.0.0.0 or ::.
BIND_ADDRESS=127.0.0.1
TESLAMATE_PORT=4000
# If occupied, change only this host port to 3001.
GRAFANA_PORT=3000
API_PORT=8080
# Optional TeslaMateAPI token, not a Tesla token; does not secure every read endpoint.
API_TOKEN=

# Frontend: copy template to apps/web/.env.local and fill ONLY frontend settings.
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_MOCK_SCENARIO=normal
# Origin only; read by the Next server. Use NAS LAN IP when developing on a laptop.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080
# Reserved empty compatibility placeholder. Never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_TOKEN=
# Optional API credential, server-side only; same value as API_TOKEN if used.
TESLAMATE_API_TOKEN=
